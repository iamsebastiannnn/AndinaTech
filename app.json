{
  "expo": {
    "name": "Andina Tech & Hogar",
    "slug": "andina-tech-hogar",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F25",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Andina Tech & Hogar",
      "shortName": "Andina",
      "lang": "es",
      "themeColor": "#0B1F25",
      "backgroundColor": "#F3F2EE",
      "description": "Distribuidora colombiana de tecnología y hogar"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font"
    ],
    "scheme": "andinatech",
    "experiments": {
      "typedRoutes": true
    }
  }
}
